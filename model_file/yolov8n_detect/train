from ultralytics import YOLO

# 모델 로드 (yolov8n 사전 학습 모델 사용)
model = YOLO('yolov8n.pt')

# 학습 파라미터 설정
model.train(
    data='/home/elicer/BGM/Detect_data/dataset.yaml',  # YAML 경로
    imgsz=640,                         # 이미지 크기
    epochs=50,                         # 총 에폭 수
    batch=16,                          # 자동 최적 배치 크기
    patience=7,                        # 7 에폭 동안 성능 향상 없으면 조기 종료
    project="pilly_detect",           # 결과 저장 프로젝트 폴더
    name="yolov8n_detect_run",        # 결과 하위 폴더 이름
    device=0                           # GPU 사용 (CUDA:0)
)

print("\n✅ YOLOv8 탐지 모델 학습 완료!")
print("📁 결과 폴더 → ./home/elicer/pilly_detect/yolov8n_detect_run/")
